# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Get these from: https://app.supabase.com/project/_/settings/api

# Your Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Your Supabase Anon/Public Key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"


# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Get from: https://app.supabase.com/project/_/settings/database
# Connection string > URI tab

# Session mode (with connection pooling) - for app queries
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Transaction mode (direct connection) - for migrations
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres"


# ===========================================
# AI/LLM CONFIGURATION (Choose ONE)
# ===========================================

# Option 1: Google Gemini (FREE - Recommended)
# Get from: https://makersuite.google.com/app/apikey
# Free tier: 60 requests/minute
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"

# Option 2: Groq (FREE and FAST)
# Get from: https://console.groq.com/keys
# Free tier: Very generous limits
# LLM_PROVIDER="groq"
# GROQ_API_KEY="your-groq-api-key-here"

# Option 3: OpenAI (PAID)
# Get from: https://platform.openai.com/api-keys
# LLM_PROVIDER="openai"
# OPENAI_API_KEY="sk-your-openai-api-key-here"


# ===========================================
# OAUTH CONFIGURATION
# ===========================================
# Get Google OAuth credentials from: https://console.developers.google.com/
# Create a new project > Credentials > Create OAuth 2.0 Client ID
# Authorized redirect URIs: https://your-project-ref.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"


# ===========================================
# APP CONFIGURATION
# ===========================================

# Your app URL (use http://localhost:3000 for development)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

